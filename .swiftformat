# Formatting is owned by SwiftFormat: `swiftformat .` fixes, `swiftformat --lint .` checks (the gate).
--swiftversion 6.2
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--patternlet inline
--importgrouping testable-last
--ranges no-space
--ifdef no-indent
--stripunusedargs closure-only
--header strip
--exclude **/.build,**/DerivedData,build,**/Resources,*.xcodeproj
--disable wrapMultilineStatementBraces,preferKeyPath,redundantReturn,propertyTypes,blankLinesBetweenImports,organizeDeclarations,swiftTestingTestCaseNames,redundantSwiftTestingSuite,hoistTry,hoistAwait,trailingCommas,docComments,wrapPropertyBodies,wrapLoopBodies,wrapConditionalBodies,wrapSwitchCases,wrapFunctionBodies
--enable isEmpty,sortImports
